# v0.3.1 — copy ke .env lalu isi. SEMUA key di bawah adalah field Settings
# resmi (`extra="forbid"`): typo / key asing = start GAGAL dengan pesan jelas.
# Key HANYA-OS-ENVIRON (jangan taruh di file ini): TEST_DATABASE_URL
# (dipakai test integrasi).
PROJECT_NAME=ai-app-boilerplate
API_V1_PREFIX=/api/v1
# APP_VERSION boleh di-override di sini, tapi OpenAPI + /health ikut berubah —
# default kode (v0.4) adalah acuan rilis.
APP_VERSION=v0.4
LOG_LEVEL=INFO

# --- Server (boleh di-override via $env OS juga) ---
HOST=127.0.0.1
# 0.0.0.0 untuk container/LAN
PORT=8000
RELOAD=false

# --- CORS ( Kredensial ON: "*" DITOLAK — sebutkan origin eksplisit) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID,X-Tenant-ID,X-User-ID

# --- Ambang middleware agen (starter UMKM; naikkan per klien bila perlu) ---
TOOLCALL_THREAD_LIMIT=15
TOOLCALL_PER_TOOL_LIMIT=5
CONTEXT_TRIGGER_TOKENS=8000
CONTEXT_KEEP_LAST_USES=3

# --- Postgres app-db (WAJIB sejak v0.3 — tanpa fallback memory) ---
# 1) cd ..\Infra; docker compose up -d app-db
# 2) samakan user/pass/db dengan APP_DB_* di Infra/.env
DATABASE_URL=postgresql+psycopg://app:changeme-appdb-pass@localhost:5433/appdb
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- v0.4: cache Valkey (rate-limit, idempotency, denylist JWT) ---
# 1) cd ..\Infra; docker compose up -d cache
# 2) password SAMA dengan CACHE_PASSWORD di Infra/.env
# Kosong = fitur cache NONAKTIF (BE tetap jalan; rate-limit tak berjalan).
# Diisi tapi tak terjangkau = app TOLAK start (fail-fast saat startup).
CACHE_URL=redis://:changeme-cache-pass@localhost:6380/0
CACHE_SOCKET_TIMEOUT=1.5

# --- v0.4: auth + hardening ---
# dev | staging | prod. ENVIRONMENT=prod mewajibkan: AUTH_MODE=jwt,
# JWT_SECRET terisi, CACHE_URL terisi, ENABLE_DOCS=false.
ENVIRONMENT=dev
AUTH_MODE=jwt
# trusted_headers = perilaku v0.3 (header X-Tenant-ID/X-User-ID dipercaya).
# HANYA dev; butuh flag di bawah + DITOLAK saat ENVIRONMENT=prod.
AUTH_ALLOW_TRUSTED_HEADERS=false
# WAJIB (min 32 char) untuk AUTH_MODE=jwt. Generate:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
JWT_SECRET=
JWT_ISSUER=ai-app-boilerplate
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# /docs + /openapi.json. Mati default; prod mewajibkan false.
ENABLE_DOCS=false

# --- v0.4: rate limit + idempotency ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_LOGIN_PER_MIN=5
IDEMPOTENCY_TTL_SECONDS=86400
MAX_JOB_PAYLOAD_BYTES=262144

# --- LLM: single gateway LiteLLM proxy (TANPA direct provider) ---
# JANGAN tulis key asli di file ini — isi di .env (yang tidak di-commit).
# Model/provider diatur di proxy UI (http://localhost:4000/ui); app hanya tahu:
LITELLM_BASE_URL=http://localhost:4000
# Virtual key per project (buat di UI → Virtual Keys). BUKAN master key!
LITELLM_API_KEY=
# Nama model di proxy, mis. kimi-primary (lihat UI → Models)
LITELLM_MODEL=
# Tag atribusi spend (kosong = pakai PROJECT_NAME)
LITELLM_PROJECT_TAG=
# Temperatur chat default 1.0 (samakan dengan kode). Untuk pipeline
# deterministik, turunkan ke 0.0 di .env project.
LLM_TEMPERATURE=1.0
LLM_TIMEOUT_SECONDS=60

# --- Observability Phoenix (false = mati default, samakan dengan kode) ---
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=boilerplate-v0

# --- HITL / approval (v0.6) ---
# true = tool di HITL_POLICY (mis. process_refund > Rp 500.000) dijeda
# untuk persetujuan manusia; keputusan lewat POST /approvals/{id}/decide.
HITL_ENABLED=false

# --- Durability checkpoint graph ---
# sync = checkpoint ditulis sebelum step berikutnya (aman untuk HITL),
# async = lebih cepat, exit = hanya di akhir run.
GRAPH_DURABILITY=async

# --- WebSocket realtime (v0.5b) ---
WS_ENABLED=true
WS_TICKET_TTL_SECONDS=30
WS_HEARTBEAT_SECONDS=25
WS_MAX_QUEUE=256
# Kosong = pakai CORS_ORIGINS. Isi untuk allowlist Origin WS terpisah (CSWSH).
WS_ORIGINS=

