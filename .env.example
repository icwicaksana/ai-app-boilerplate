# v0 — copy ke .env lalu isi
PROJECT_NAME=ai-boilerplate-v0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Kosongkan = jalan tanpa Postgres (pakai memory checkpointer, cocok untuk dev cepat)
# Isi untuk pakai Postgres checkpointer:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_boilerplate
DATABASE_URL=

# --- LLM ---
# Pilih provider: openai | opencode_go
MODEL_PROVIDER=opencode_go
# OpenAI (jika MODEL_PROVIDER=openai)
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
# OpenCode Go (jika MODEL_PROVIDER=opencode_go). JANGAN tulis key asli di file ini —
# isi di .env (yang tidak di-commit). Model harus dari endpoint chat/completions,
# mis: kimi-k2.7-code, glm-5.3-flash, deepseek-v4-flash, space-bunny-free
OPENCODE_API_KEY=
OPENCODE_MODEL=kimi-k2.7-code
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# --- Observability Phoenix (false = jalan tanpa tracing) ---
PHOENIX_ENABLED=True
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=boilerplate-v0

# --- HITL (v0 selalu false, slot untuk v1) ---
HITL_ENABLED=false
