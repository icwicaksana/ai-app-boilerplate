# v1.0 — copy ke .env lalu isi. SEMUA key di bawah adalah field Settings
# resmi (`extra="forbid"`): typo / key asing = start GAGAL dengan pesan jelas.
# Key HANYA-OS-ENVIRON (jangan taruh di file ini): TEST_DATABASE_URL
# (dipakai test integrasi).
PROJECT_NAME=ai-app-boilerplate
API_V1_PREFIX=/api/v1
# APP_VERSION boleh di-override di sini, tapi OpenAPI + /health ikut berubah —
# default kode (v0.9.0; jadi v1.0 saat rilis V1-G) adalah acuan rilis.
APP_VERSION=v0.9.0
LOG_LEVEL=INFO

# --- Server (boleh di-override via $env OS juga) ---
HOST=127.0.0.1
# 0.0.0.0 untuk container/LAN
PORT=8000
RELOAD=false

# --- CORS ( Kredensial ON: "*" DITOLAK — sebutkan origin eksplisit) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID

# --- Ambang middleware agen (starter UMKM; naikkan per klien bila perlu) ---
TOOLCALL_THREAD_LIMIT=15
TOOLCALL_PER_TOOL_LIMIT=5
CONTEXT_TRIGGER_TOKENS=8000
CONTEXT_KEEP_LAST_USES=3

# --- Postgres app-db (WAJIB sejak v0.3 — tanpa fallback memory) ---
# 1) cd ..\Infra; docker compose up -d app-db
# 2) samakan user/pass/db dengan APP_DB_* di Infra/.env
DATABASE_URL=postgresql+psycopg://app:changeme-appdb-pass@localhost:5433/appdb
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- v0.4: cache Valkey (rate-limit, idempotency, denylist JWT) ---
# 1) cd ..\Infra; docker compose up -d cache
# 2) password SAMA dengan CACHE_PASSWORD di Infra/.env
# Kosong = fitur cache NONAKTIF (BE tetap jalan; rate-limit tak berjalan).
# Diisi tapi tak terjangkau = app TOLAK start (fail-fast saat startup).
CACHE_URL=redis://:changeme-cache-pass@localhost:6380/0
CACHE_SOCKET_TIMEOUT=1.5

# --- v0.4: auth + hardening ---
# dev | staging | prod. ENVIRONMENT=prod mewajibkan: AUTH_MODE=jwt,
# JWT_SECRET terisi, CACHE_URL terisi, ENABLE_DOCS=false.
ENVIRONMENT=dev
AUTH_MODE=jwt
# v0.8.1: mode trusted_headers DIHAPUS. Hanya JWT Bearer yang didukung.
# HANYA dev; butuh flag di bawah + DITOLAK saat ENVIRONMENT=prod.
# (AUTH_ALLOW_TRUSTED_HEADERS dihapus v0.8.1)
# WAJIB (min 32 char) untuk AUTH_MODE=jwt. Generate:
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
JWT_SECRET=
JWT_ISSUER=ai-app-boilerplate
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# /docs + /openapi.json. Mati default; prod mewajibkan false.
ENABLE_DOCS=false
# v1.0: /metrics ter-guard. Isi = scrape wajib Bearer; kosong = loopback saja.
METRICS_TOKEN=

# --- v0.4: rate limit + idempotency ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_JOBS_PER_MIN=10
RATE_LIMIT_LOGIN_PER_MIN=5
IDEMPOTENCY_TTL_SECONDS=86400
MAX_JOB_PAYLOAD_BYTES=262144

# --- LLM: single gateway LiteLLM proxy (TANPA direct provider) ---
# JANGAN tulis key asli di file ini — isi di .env (yang tidak di-commit).
# Model/provider diatur di proxy UI (http://localhost:4000/ui); app hanya tahu:
LITELLM_BASE_URL=http://localhost:4000
# Virtual key per project (buat di UI → Virtual Keys). BUKAN master key!
LITELLM_API_KEY=
# Nama model di proxy, mis. kimi-primary (lihat UI → Models)
LITELLM_MODEL=
# Tag atribusi spend (kosong = pakai PROJECT_NAME)
LITELLM_PROJECT_TAG=
# Temperatur chat default 1.0 (samakan dengan kode). Untuk pipeline
# deterministik, turunkan ke 0.0 di .env project.
LLM_TEMPERATURE=1.0
LLM_TIMEOUT_SECONDS=60

# --- Observability Phoenix (false = mati default, samakan dengan kode) ---
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=boilerplate-v0

# --- HITL / approval (v0.6) ---
# true = tool di HITL_POLICY (mis. process_refund > Rp 500.000) dijeda
# untuk persetujuan manusia; keputusan lewat POST /approvals/{id}/decide.
HITL_ENABLED=false

# --- Skills (v0.9, default NYALA di kode) ---
# Kill-switch darurat: false = matikan paksa walau konten ada.
# Normalnya tak perlu ditulis — tanpa konten (dir skills/ kosong),
# perilaku byte-identik seolah mati.
#SKILLS_ENABLED=true

# --- Subagents (v0.9, default MATI — disengaja) ---
# Opt-in: true = aktifkan delegasi bila roster tak kosong. Tetap default
# mati karena roster GLOBAL vs TOOLS per-agen (default-on meledak LOUD di
# agen yang tak punya tool spec). Butuh scoping roster per-agen dulu.
#SUBAGENTS_ENABLED=false

# --- Durability checkpoint graph ---
# sync = checkpoint ditulis sebelum step berikutnya (aman untuk HITL),
# async = lebih cepat, exit = hanya di akhir run.
GRAPH_DURABILITY=async

# --- WebSocket realtime (v0.5b) ---
WS_ENABLED=true
WS_TICKET_TTL_SECONDS=30
WS_HEARTBEAT_SECONDS=25
WS_MAX_QUEUE=256
# Batas umur koneksi: handshake hanya membuktikan identitas SEKALI. Setelah
# batas ini server kirim `auth_expired` lalu close 4001 → klien minta ticket
# baru, reconnect, dan `resume` turn (tanpa kehilangan token jawaban).
WS_MAX_CONNECTION_SECONDS=1800
# Kosong = pakai CORS_ORIGINS. Isi untuk allowlist Origin WS terpisah (CSWSH).
WS_ORIGINS=

# --- RAG (v0.7; desain beku: Docs/RAG-V07-DESIGN.md) ---
# Backend vektor: pgvector (default, di app-db) | qdrant (opt-in).
# Setting DEPLOY — pindah backend = reindex eksplisit (D4).
RAG_BACKEND=pgvector
# Dedicated infra embedding (compose terpisah — JANGAN satukan dengan BE):
#   cd ..\Infra; docker compose -f docker-compose.embed.yml up -d
RAG_EMBED_BASE_URL=http://localhost:7997
RAG_EMBED_MODEL=BAAI/bge-m3
# Pin versi embed (kosong = jangan validasi versi). Isi = startup tolak bila
# chunks.embedding_version berbeda (anti campur revisi model/kuantisasi).
RAG_EMBED_VERSION=
# true = embed/rerank/vector gagal → tolak start (default, ADR-12);
# false = RAG degraded, API non-RAG tetap jalan.
RAG_STRICT_STARTUP=true
RAG_RERANK_BASE_URL=http://localhost:7997
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Qdrant (wajib keduanya bila RAG_BACKEND=qdrant, fail-fast):
#   1) isi QDRANT_API_KEY di Infra/.env (SAMA dengan yang di bawah)
#   2) cd ..\Infra; docker compose --profile qdrant up -d qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Batas ingest: tolak 413 SEBELUM enqueue.
RAG_MAX_UPLOAD_BYTES=20971520
RAG_MAX_PAGES_PDF=200
RAG_MAX_XLSX_CELLS=200000
RAG_STORAGE_DIR=data/uploads
# Cache HuggingFace lokal repo (tokenizer dsb). BUKAN ~/.cache (reproducible +
# ramah container). Hormati HF_HUB_CACHE eksplisit bila operator menyetelnya.
RAG_HF_CACHE=.hf-cache
# Angka pipeline hybrid (config, bukan kontrak beku).
RAG_RRF_K=60
RAG_DENSE_TOP=50
RAG_LEXICAL_TOP=50
RAG_CANDIDATE_TOP=20
RAG_FINAL_TOP=5
RAG_QUERY_MAX_TOK=128
RAG_DOC_MAX_TOK=384
RAG_PAIR_MAX_TOK=512
# Floor skor rerank (kalibrasi F6: 0.05; 0.0 = nonaktif). Semua kandidat di
# bawah ini → retrieval_status=no_evidence → agen menolak tanpa panggil LLM.
RAG_RERANK_SCORE_FLOOR=0.05
# Stemming Sastrawi di normalize.py (default true). WAJIB sama saat index
# dan query — ganti nilai = reindex (atau lexical miss sistematis).
RAG_STEMMER=true
# Fallback embedding MODEL-IDENTIK (v0.7.1 F5b, opsional): endpoint
# OpenAI-compatible `/embeddings` dengan MODEL SAMA persis. Nama + dims
# divalidasi saat start (beda = tolak start, D6). Fallback down saat start
# = warning + lanjut tanpa fallback; primer mati saat jalan = failover
# per-request otomatis (+recovery otomatis). Contoh: replika Infinity kedua
# atau gateway LiteLLM yang serve model identik.
RAG_EMBED_FALLBACK_URL=
RAG_EMBED_FALLBACK_MODEL=
RAG_EMBED_TIMEOUT_MS=1500
RAG_RERANK_TIMEOUT_MS=2500
# 1 HANYA untuk re-index bertahap. Default 0 = tolak start bila RAG_EMBED_*
# tak cocok dengan kolom/index (anti vektor campur, D6).
RAG_ALLOW_MIXED=false
# Worker ingest (proses terpisah: python -m app.workers.ingest).
WORKER_DB_POOL_MIN=2
WORKER_DB_POOL_MAX=5
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=0.5
RAG_LEASE_SECONDS=120
# Kunci Fernet envelope untuk secret konektor (44ch base64). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOURCE_CONN_KEY=
RATE_LIMIT_INGEST_PER_MIN=5
# Bucket retrieval TERPISAH (search cepat & sering; ingest berat & jarang).
RATE_LIMIT_RETRIEVAL_PER_MIN=30
# OCR: auto = tawarkan OCR_REQUIRED bila teks minim; on = selalu OCR bila
# diminta; off = tolak dokumen pindai.
OCR_MODE=auto
OCR_LANGS=ind+eng
OCR_TIMEOUT_SECONDS=60
OCR_MAX_PAGES=50

# --- Knowledge Graph (v0.8; desain: Docs/RAG-V08-DESIGN.md, runbook:
# Docs/RAG-V08-RUNBOOK.md). Default MATI (GRAPH_ENABLED=false).
# Menyalakan: set true + MODEL stub (uji) atau fastino (produksi) +
# unduh model GLiNER ke .hf-cache (lihat runbook §1).
GRAPH_ENABLED=false
GRAPH_EXTRACTOR_MODEL=fastino/gliner2.5-multi-v1
GRAPH_EXTRACTOR_VERSION=v1
# Trigger L3: L2 menyerah (0 edge ATAU semua edge < 0.5) DAN sensitif.
GRAPH_L3_MODEL=
GRAPH_L3_VERSION=
GRAPH_L3_MAX_CALLS_PER_DOC=20
GRAPH_L3_MAX_TOKENS_IN=1500
GRAPH_L3_MAX_TOKENS_OUT=600
GRAPH_L3_DAILY_QUOTA_PER_WORKSPACE=500
GRAPH_L3_BREAKER_MINUTES=15
GRAPH_L3_CACHE_TTL_DAYS=7
# Retrieval graph (kalibrasi F5 run 7; niat tiap knob di DESIGN §8).
GRAPH_SEED_TOP=8
GRAPH_EXPAND_TOP=20
GRAPH_MAX_HOPS=2
GRAPH_BFS_FANOUT=50
GRAPH_TIMEOUT_MS=800
GRAPH_SEED_CONFIDENCE=0.5
GRAPH_SCORE_FLOOR=0.10
GRAPH_KG_QUOTA_PER_WORKSPACE=200000
# Tulis graph (worker): cap/chunk, cap/dok, floor confidence ekstraktor.
GRAPH_MAX_ENTITIES_PER_CHUNK=12
GRAPH_MAX_EDGES_PER_DOC=500
GRAPH_MIN_CONFIDENCE=0.0
GRAPH_EXTRACT_BATCH=8

